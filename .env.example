# Copy to .env (cp .env.example .env) and adjust. Never commit .env.
# Every setting has a safe default in internal/config/config.go except the
# ones marked "required". Real environment variables override this file.

# development | production  (production = JSON logs, quieter SQL logging)
APP_ENV=development
APP_SHUTDOWN_TIMEOUT=15s

# Listeners
CONTROLPLANE_ADDR=:8080
EXECUTOR_OPS_ADDR=:8081
ROUTER_ADDR=:8000
ROUTER_OPS_ADDR=:8082

# Postgres — required by controlplane and executor (not by router)
DATABASE_DSN=postgres://forgeops:forgeops@localhost:5433/forgeops?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=5m

# Redis — used by all three services
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# MinIO (S3 API) — not read by any service until Phase 7; listed so the
# credentials match deploy/docker-compose.yml.
# S3_ENDPOINT=http://localhost:9010
# S3_ACCESS_KEY_ID=forgeops
# S3_SECRET_ACCESS_KEY=forgeops-secret
